APP_ENV=development
APP_NAME=SoouqLive Merchant Discovery
APP_SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=true

DATABASE_URL=postgresql+asyncpg://merchant:merchant@localhost:5432/merchant_db
DATABASE_URL_SYNC=postgresql+psycopg2://merchant:merchant@localhost:5432/merchant_db

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET_KEY=change-me-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GOOGLE_MAPS_API_KEY=
BUSINESS_PROVIDER_API_KEY=

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SUPPRESSION_HMAC_SECRET=change-me-suppression-hmac-secret
EXPORT_STORAGE_PATH=./storage/exports
EXPORT_EXPIRY_HOURS=24

SEED_ADMIN_EMAIL=admin@soouqlive.example
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_NAME=System Admin
